# =============================================
# NMAMIT Placement Portal — Environment Variables
# Copy this file to .env and fill in values
# =============================================

# Database
DB_NAME=placement_db
DB_USERNAME=placement_user
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=your_secure_root_password
MYSQL_PORT=3307

# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
BACKEND_PORT=8080

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=your_very_long_random_jwt_secret_key_here
JWT_EXPIRATION=3600000

# File Storage
RESUME_UPLOAD_DIR=/app/uploads/resumes

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-flutter-web-domain.com

# Swagger / API
API_SERVER_URL=https://your-api-domain.com
