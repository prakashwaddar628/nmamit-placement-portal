# ============================================================
#  NMAMIT Placement Portal — Root .gitignore
#  Covers: Spring Boot (Maven / Java), Flutter / Dart,
#          IDEs (IntelliJ, VS Code, Eclipse), OS artifacts
# ============================================================

# ──────────────────────────────────────────────────────────
#  SENSITIVE / ENVIRONMENT CONFIG  ← most important section
# ──────────────────────────────────────────────────────────
**/application.properties
**/application.yml
**/application-*.properties
**/application-*.yml
!**/application-*.properties.example
!**/application-*.yml.example

**/.env
**/.env.*
!**/.env.example

# ──────────────────────────────────────────────────────────
#  JAVA / MAVEN
# ──────────────────────────────────────────────────────────
# Build output
**/target/
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper binary (the .properties file IS tracked)
.mvn/wrapper/maven-wrapper.jar
**/HELP.md

# Compiled artefacts
*.class
*.jar
*.war
*.ear
*.nar

# Log files
*.log
**/logs/

# ──────────────────────────────────────────────────────────
#  UPLOADED / GENERATED FILES  (local file storage)
# ──────────────────────────────────────────────────────────
**/uploads/photos/
**/uploads/resumes/
**/uploads/job-descriptions/
# Keep the directory placeholders
!**/uploads/**/.gitkeep

# ──────────────────────────────────────────────────────────
#  FLUTTER / DART
# ──────────────────────────────────────────────────────────
# Build outputs
flutter/**/build/

# Dart tool cache & pub
flutter/**/.dart_tool/
flutter/**/.packages
flutter/**/.pub-cache/
flutter/**/.pub/
flutter/**/pubspec.lock

# Generated source files
flutter/**/*.g.dart
flutter/**/*.freezed.dart
flutter/**/*.mocks.dart
flutter/**/*.chopper.dart

# Coverage
flutter/**/coverage/

# iOS
flutter/**/ios/Pods/
flutter/**/ios/.symlinks/
flutter/**/ios/Flutter/Flutter.framework
flutter/**/ios/Flutter/Flutter.podspec
flutter/**/ios/Flutter/Generated.xcconfig
flutter/**/ios/Runner/GeneratedPluginRegistrant.*

# macOS
flutter/**/macos/Pods/
flutter/**/macos/Flutter/GeneratedPluginRegistrant.swift
flutter/**/macos/Flutter/ephemeral/

# Android
flutter/**/android/.gradle/
flutter/**/android/local.properties
flutter/**/android/key.properties
flutter/**/*.keystore
flutter/**/*.jks

# Firebase credentials (never commit)
flutter/**/android/app/google-services.json
flutter/**/ios/Runner/GoogleService-Info.plist
flutter/**/macos/Runner/GoogleService-Info.plist

# ──────────────────────────────────────────────────────────
#  IDEs — IntelliJ IDEA / Android Studio
# ──────────────────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/

# ──────────────────────────────────────────────────────────
#  IDEs — Eclipse / Spring Tool Suite (STS)
# ──────────────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# ──────────────────────────────────────────────────────────
#  IDEs — VS Code
# ──────────────────────────────────────────────────────────
.vscode/
# Allow sharing recommended extensions and example settings
!.vscode/extensions.json
!.vscode/settings.json.example

# ──────────────────────────────────────────────────────────
#  IDEs — NetBeans
# ──────────────────────────────────────────────────────────
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ──────────────────────────────────────────────────────────
#  OS ARTIFACTS
# ──────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ──────────────────────────────────────────────────────────
#  MISC
# ──────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.swp
*.swo
node_modules/
.gradle/
